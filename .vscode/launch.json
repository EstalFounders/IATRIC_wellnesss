{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Browser UI",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Next.js: Server (main 9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "restart": true,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Next.js: Full-Stack (All)",
      "configurations": [
        "Next.js: Browser UI",
        "Next.js: Server (main 9229)"
      ]
    }
  ]
}
